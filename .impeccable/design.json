  "narrative": {
    "northStar": "家居杂志 · 空间作品刊页",
    "overview": "2026-10-25 用户明确选择家居杂志（editorial）作为唯一生产视觉基线，并亲自将原型移至 `example/prototypes/projects`。暖纸导读、仓耳渔阳体项目名和实时三维空间组成作品刊页：先探索空间，再进入编辑，项目管理收进索引。生产不再要求建筑展馆主题或主题切换。\n\n历史原型保留建筑展馆与家居杂志两套表达；gallery 元数据及原有通用组件的展馆回退仅是历史，不构成生产双主题要求。生产继承 editorial/folio 的空间、字体与动效规则。",
    "keyCharacteristics": [
      "生产采用杂志导读、实时空间与方案轨道；原型历史仍保留展馆侧栏与模型封面目录。",
      "纸色与墨色承载内容；酒红用于动作、选中与项目名字的强调。",
      "示例方案共享观察方位，比较实际家具摆放与组合。",
      "平面刊页、细分隔线和少量浮动控件形成层级。"
    ],
    "rules": [
      {
        "name": "Shared Action Rule",
        "body": "生产主操作、房间选中、输入焦点和材质选中沿用家居杂志的酒红强调色；历史原型的主题切换不改变操作含义。",
        "section": "colors"
      },
      {
        "name": "Editorial Production Rule",
        "body": "生产统一采用家居杂志布局、字号、留白与仓耳渔阳体；紧凑工具与数值编辑沿用操作字号。两套视觉的对比仅保留在历史原型。",
        "section": "typography"
      },
      {
        "name": "Canvas Layer Rule",
        "body": "普通项目条目与工作面保持平面结构，浮动工具与模态对话框才使用明显的柔和阴影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 生产继承 editorial 实时空间刊页结构；gallery 目录仅在历史原型保留。",
      "**Do** 生产使用 editorial / folio 变量，并区分刊页局部纸色与工作台纸色。",
      "**Do** 保留真实模型、示例尺寸、手动描绘、演示助手和本地保存标识。",
      "**Do** 检查横屏、竖屏与手机构图，以及键盘焦点和 reduced-motion 分支。"
    ],
    "donts": [
      "**Don't** 将旧的精选卡片首页继续当作当前杂志方向，或把换色称为结构重做。",
      "**Don't** 将固定设施随家具风格移动，或把仅换色称为布局方案。",
      "**Don't** 将尚未验收的真实模型、自动识图、云部署或预算模块写成现有能力；账号与项目保存仅按 T04 本地验收范围说明。",
      "**Don't** 将辅助小字推广为正文标准，或把测试通过、历史 ship 当作获奖品质证明。"
    ]
  }
}
