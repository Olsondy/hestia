# Local development only. pnpm setup:local generates .env without exposing secrets.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://hestia:replace-with-local-password@127.0.0.1:54329/hestia
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
PRIVATE_STORAGE_PATH=./private-data
# Server-side model validation. Set these in the existing root .env; never commit the key.
# HTTPS OpenAI-compatible base URL, without the /chat/completions suffix.
# Model must support images, streaming and tool calls. Offline checks do not require it.
# HESTIA_MODEL_API_KEY=
# HESTIA_MODEL_BASE_URL=
# HESTIA_MODEL_ID=
# D02 customer phone sign-in. SMS_PROVIDER=mock sends nothing: the code goes to the server log and is returned
# to the H5 page as a demo code. mock is refused when NODE_ENV=production; unset disables phone sign-in.
# No real provider adapter exists yet. Never commit provider credentials.
SMS_PROVIDER=mock
# Optional limits (defaults shown): code lifetime, wrong attempts per code, resend cooldown, rate window,
# sends per phone number and per source within the window.
# HESTIA_OTP_TTL_SECONDS=300
# HESTIA_OTP_MAX_ATTEMPTS=5
# HESTIA_OTP_RESEND_SECONDS=60
# HESTIA_OTP_RATE_WINDOW_SECONDS=3600
# HESTIA_OTP_MAX_PER_PHONE=5
# HESTIA_OTP_MAX_PER_SOURCE=20
# Header carrying the client IP, set only by a trusted proxy (e.g. x-real-ip). Unset: all sources share one bucket.
# HESTIA_OTP_SOURCE_HEADER=
# DXF floor-plan import Worker (pnpm setup:dxf creates .venv/dxf). Optional overrides:
# HESTIA_DXF_PYTHON=           # converter interpreter, default .venv/dxf/bin/python
# HESTIA_DXF_TIMEOUT_MS=60000  # per-conversion wall clock
# HESTIA_DXF_MAX_ENTITIES=200000
# HESTIA_IMPORT_LEASE_SECONDS=120
# Deployment switches (ADR-0007, ADR-0015). Enterprise-facing deployments close open registration. The root path is
# the site entry; HESTIA_HOME_ENTRY names the enterprise its customer and workbench doors lead to (/c/…, /w/…).
# HESTIA_REGISTRATION=closed
# HESTIA_HOME_ENTRY=demo-home
# Offline demo on one machine: all customers share one source bucket, so raise the per-source limit.
# HESTIA_OTP_MAX_PER_SOURCE=200
# Behind a tunnel or proxy (e.g. cloudflared), count codes per visitor by the header the proxy sets:
# HESTIA_OTP_SOURCE_HEADER=cf-connecting-ip
# HESTIA_OTP_MAX_PER_PHONE=30
# NEXT_TELEMETRY_DISABLED=1
