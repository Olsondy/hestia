{
  "name": "hestia",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "description": "Hestia: a spatial design workbench for importing floor plans, editing layouts and presenting homes in 3D.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/check.mjs",
    "check": "pnpm build && pnpm test && pnpm typecheck && pnpm test:core",
    "preview": "node scripts/serve.mjs",
    "fonts": "node scripts/source-fonts.mjs",
    "typecheck": "next typegen apps/web && tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json",
    "test:core": "node scripts/test-core.mjs",
    "test:db": "node --env-file=.env --import tsx --test packages/projects/src/service.test.ts packages/identity/src/identity.integration.test.ts packages/commands/src/service.test.ts packages/files/src/service.integration.test.ts packages/candidates/src/service.test.ts packages/tasks/src/runtime.test.ts packages/renders/src/service.test.ts packages/styles/src/service.test.ts packages/conversation/src/runtime.test.ts packages/conversation/src/requirements.test.ts packages/conversation/src/budget.test.ts packages/layout-planner/src/service.test.ts packages/layout-planner/src/continuation.test.ts",
    "validate:projects": "node --env-file=.env --import tsx scripts/validation/project-api.ts",
    "validate:editing": "node --env-file=.env --import tsx scripts/validation/editing-api.ts && node --env-file=.env --import tsx scripts/validation/editing-ui.ts",
    "dev": "node scripts/web.mjs dev",
    "build:web": "node scripts/web.mjs build",
    "start:web": "node scripts/web.mjs start",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "invite": "node --env-file=.env --import tsx scripts/invite.ts",
    "validate:candidates": "node --env-file=.env --import tsx scripts/validation/candidate-ui.ts",
    "validate:underlay": "node --env-file=.env --import tsx scripts/validation/underlay-browser.ts",
    "worker:setup": "node --env-file=.env --import tsx scripts/worker.ts --setup",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "render:setup": "node --env-file=.env --import tsx scripts/render-worker.ts --setup",
    "worker:render": "node --env-file=.env --import tsx scripts/render-worker.ts",
    "validate:catalog": "node --env-file=.env --import tsx scripts/validation/catalog-ui.ts",
    "validate:renders": "node --env-file=.env --import tsx scripts/validation/render-ui.ts",
    "validate:styles": "node --env-file=.env --import tsx scripts/validation/style-ui.ts",
    "validate:conversation": "node --env-file=.env --import tsx scripts/validation/conversation-ui.ts",
    "validate:layout": "node --env-file=.env --import tsx scripts/validation/layout-api.ts",
    "validate:layout-ui": "node --env-file=.env --import tsx scripts/validation/layout-resilience-ui.ts",
    "validate:credits-api": "node --env-file=.env --import tsx --test packages/credits/src/registration.integration.test.ts",
    "validate:credits-ui": "node --env-file=.env --import tsx scripts/validation/free-experience-ui.ts",
    "validate:continuation-ui": "node --env-file=.env --import tsx scripts/validation/continuation-ui.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.78",
    "@tanstack/react-query": "5.104.5",
    "ai": "7.0.153",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "konva": "10.9.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "polygon-clipping": "0.15.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
