# Local development only. pnpm setup:local generates .env without exposing secrets.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://hestia:replace-with-local-password@127.0.0.1:54329/hestia
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
PRIVATE_STORAGE_PATH=./private-data
# Models are registered in the platform console (ADR-0018); the app and Worker never read a model from here.
# Only the standalone T01/T02 evaluation scripts under scripts/validation still take a model from these variables.
# HTTPS OpenAI-compatible base URL, without the /chat/completions suffix. Never commit the key.
# HESTIA_MODEL_API_KEY=
# HESTIA_MODEL_BASE_URL=
# HESTIA_MODEL_ID=
# Live layout validation scripts (layout-api, layout-continuation-api): the id of an admitted model in the registry.
# HESTIA_VALIDATION_MODEL=
# D02 customer phone sign-in. SMS_PROVIDER=mock sends nothing: the code goes to the server log and is returned
# to the H5 page as a demo code. mock is refused when NODE_ENV=production; unset disables phone sign-in.
# SMS_PROVIDER=tencent sends through Tencent Cloud SMS. Never commit provider credentials.
SMS_PROVIDER=mock
# Tencent Cloud SMS (SMS_PROVIDER=tencent). A CAM sub-account key limited to SMS; SDK AppID, approved signature
# and verification-code template from the SMS console. TEMPLATE_PARAMS maps the template's {1},{2}… in order:
# "code" for a template with only {1}; "code,minutes" when {2} is the validity in minutes.
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_TEMPLATE_PARAMS=code
# TENCENT_SMS_REGION=ap-guangzhou
# TENCENT_SMS_TIMEOUT_MS=10000
# Optional limits (defaults shown): code lifetime, wrong attempts per code, resend cooldown, rate window,
# sends per phone number and per source within the window.
# HESTIA_OTP_TTL_SECONDS=300
# HESTIA_OTP_MAX_ATTEMPTS=5
# HESTIA_OTP_RESEND_SECONDS=60
# HESTIA_OTP_RATE_WINDOW_SECONDS=3600
# HESTIA_OTP_MAX_PER_PHONE=5
# HESTIA_OTP_MAX_PER_SOURCE=20
# Header carrying the client IP, set only by a trusted proxy (e.g. x-real-ip). Unset: all sources share one bucket.
# HESTIA_OTP_SOURCE_HEADER=
# DXF floor-plan import Worker (pnpm setup:dxf creates .venv/dxf). Optional overrides:
# HESTIA_DXF_PYTHON=           # converter interpreter, default .venv/dxf/bin/python
# HESTIA_DXF_TIMEOUT_MS=60000  # per-conversion wall clock
# HESTIA_DXF_MAX_ENTITIES=200000
# HESTIA_IMPORT_LEASE_SECONDS=120
# Deployment switches (ADR-0007, ADR-0015). Enterprise-facing deployments close open registration. The root path is
# the site entry; HESTIA_HOME_ENTRY names the deployment's one enterprise, served at /c (customers) and /w (members).
# HESTIA_REGISTRATION=closed
# HESTIA_HOME_ENTRY=demo-home
# Shared deployment (ADR-0017): entry domains registered with `pnpm workspace:domain <slug> add <host>` decide the
# enterprise per request; HESTIA_HOME_ENTRY is the fallback for unregistered hosts. Behind a proxy that rewrites Host,
# name the header carrying the visitor's host (the last entry of a list is used):
# HESTIA_HOST_HEADER=x-forwarded-host
# Platform console (ADR-0018): the only host that serves /admin and /api/admin, e.g. admin.<main domain>. Unset: no console.
# Its parent is treated as our main domain; admin, www, api, static and mail under it cannot be registered to an enterprise.
# HESTIA_ADMIN_HOST=admin.localhost
# Master key for model API keys at rest (AES-256-GCM): 32 bytes as base64 or 64 hex characters, e.g. `openssl rand -base64 32`.
# Required when HESTIA_ADMIN_HOST is set. Losing it means every stored model key has to be entered again.
# HESTIA_SECRET_KEY=
# Fair Workers across enterprises (M03). Jobs run at once per Worker (default 1); one workspace holds at most the group
# limit of them (default: all slots but one); per-slug overrides as JSON. Same for TASK and IMPORT.
# Render backend for headless WebGL (default swiftshader: software, works without a GPU). On a host with a GPU, e.g.
# d3d11 on Windows or metal on macOS. Rendered files go to this host's PRIVATE_STORAGE_PATH, so Web must read the same storage.
# HESTIA_RENDER_ANGLE=swiftshader
# HESTIA_RENDER_WORKER_SLOTS=2
# HESTIA_RENDER_GROUP_LIMIT=1
# HESTIA_RENDER_GROUP_LIMITS={"enterprise-a":2}
# Remote demo on a production build (pnpm demo:build / demo:start): allows the mock SMS sender there. Never set it
# for a real deployment.
# HESTIA_DEMO=1
# Offline demo on one machine: all customers share one source bucket, so raise the per-source limit.
# HESTIA_OTP_MAX_PER_SOURCE=200
# Behind a tunnel or proxy (e.g. cloudflared), count codes per visitor by the header the proxy sets:
# HESTIA_OTP_SOURCE_HEADER=cf-connecting-ip
# HESTIA_OTP_MAX_PER_PHONE=30
# NEXT_TELEMETRY_DISABLED=1
